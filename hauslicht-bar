# Texts
# ---------------------------------------------------------------------------

DE = {
    "All bulbs": "Alle Lampen",
    "on": "an",
    "off": "aus",
    "connected": "verbunden",
    "held": "getrennt (gehalten)",
    "failed": "nicht verbunden",
    "idle": "ungenutzt",
    "unknown": "unbekannt",
    "Automatic": "Automatisch",
    "Manual": "Manuell",
    "disconnected": "nicht verbunden",
    "unreachable": "nicht erreichbar",
    "Haus.Licht service not reachable": "Haus.Licht-Dienst nicht erreichbar",
    "No bulbs": "Keine Lampen",
    "Profile": "Profil",
    "Haus.Licht is too old for this module: please update it":
        "Haus.Licht ist zu alt für dieses Modul: bitte aktualisieren",
}


def german() -> bool:
    """LC_ALL, LC_MESSAGES or LANG (the first one set) starts with de."""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var)
        if v:
            return v.lower().startswith("de")
    try:
        return (locale.getlocale()[0] or "").lower().startswith("de")
    except ValueError:
        return False


def tr(s: str) -> str:
    return DE.get(s, s) if german() else s


ICONS = {
    # one family: filled, hollow, dotted, crossed out
    "unicode": {"on": "◉", "off": "○", "disconnected": "◌", "unreachable": "⊘"},
    # Nerd Font (Material Design) bulbs: lightbulb, lightbulb-outline,
    # lightbulb-off-outline, lightbulb-off
    "nerd": {"on": "\U000f0335", "off": "\U000f0336", "disconnected": "\U000f0e50",
             "unreachable": "\U000f0e4f"},
}

DEFAULT_TEXT = "{icon} {brightness}%"


# ---------------------------------------------------------------------------
# State -> view
# ---------------------------------------------------------------------------

def selection_bulbs(st: dict) -> list:
    """The bulbs the selection means: the widget's used bulbs, or the one."""
    blist = st.get("bulbs_list") or []
    sel = st.get("selected") or "all"
    if sel == "all":
        ids = st.get("in_widget") or []
        return [b for i in ids for b in blist if b.get("id") == i]
    return [b for b in blist if b.get("id") == sel]


def state_class(st: Optional[dict]) -> str:
    """on / off / disconnected / unreachable."""
    if st is None:
        return "unreachable"
    if st.get("link") in ("held", "failed") or st.get("connected") is False:
        return "disconnected"
    return "on" if st.get("power") else "off"


def _num(x) -> Optional[float]:
    return float(x) if isinstance(x, (int, float)) and not isinstance(x, bool) else None


def _pct(x) -> str:
    v = _num(x)
    if v is None:
        return "–"
    return f"{v:.0f}" if v == int(v) or v >= 10 else f"{v:.1f}"


def view(st: Optional[dict], template: str = DEFAULT_TEXT, icons: str = "unicode") -> dict:
    """Everything a format needs: text, tooltip, class, percentage, alt."""
    cls = state_class(st)
    icon = ICONS[icons][cls]
    if st is None:
        fields = {"icon": icon, "brightness": "–", "state": tr("unreachable"), "name": "",
                  "mode": "", "profile": ""}
        return {"text": _fill(template, fields), "tooltip": tr("Haus.Licht service not reachable"),
                "class": cls, "percentage": 0, "alt": cls}
    sel = st.get("selected") or "all"
    if sel == "all":
        name = tr("All bulbs")
    else:
        name = next((b.get("name") or sel for b in selection_bulbs(st)), sel)
    mode = tr("Automatic") if st.get("following") else tr("Manual")
    pct = _num(st.get("bulbs"))
    state_word = tr(cls) if cls == "disconnected" else (tr("on") if cls == "on" else tr("off"))
    fields = {"icon": icon, "brightness": _pct(pct), "state": state_word, "name": name,
              "mode": mode, "profile": st.get("profile") or ""}
    lines = [f"Haus.Licht · {name} · {mode}"]
    if not protocol_ok(st):
        lines.append(tr("Haus.Licht is too old for this module: please update it"))
    used = [b for i in (st.get("in_widget") or []) for b in (st.get("bulbs_list") or [])
            if b.get("id") == i]
    for b in used:
        on = tr("on") if b.get("power") else tr("off")
        link = b.get("link") or ("connected" if b.get("connected") else "unknown")
        lines.append(f"{b.get('name') or b.get('id')}: {on}, {_pct(b.get('output'))} %, {tr(link)}")
    if not used:
        lines.append(tr("No bulbs"))
    if st.get("profile"):
        lines.append(f"{tr('Profile')}: {st['profile']}")
    return {"text": _fill(template, fields), "tooltip": "\n".join(lines), "class": cls,
            "percentage": int(round(pct)) if pct is not None else 0, "alt": cls}


class _Keep(dict):
    def __missing__(self, key):
        return "{" + key + "}"


def _fill(template: str, fields: dict) -> str:
    try:
        return template.format_map(_Keep(fields)).strip()
    except (ValueError, IndexError, AttributeError):
        return template


def _pango(s: str) -> str:
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def render(st: Optional[dict], fmt: str = "waybar", template: str = DEFAULT_TEXT,
           icons: str = "unicode") -> str:
    """One output line for the bar."""
    v = view(st, template, icons)
    if fmt == "waybar":
        # Waybar reads text and tooltip as Pango markup.
        return json.dumps({"text": _pango(v["text"]), "tooltip": _pango(v["tooltip"]),
                           "class": v["class"], "percentage": v["percentage"], "alt": v["alt"]},
                          ensure_ascii=False)
    if fmt == "i3blocks":
        return json.dumps({"full_text": v["text"], "short_text": v["text"],
                           "urgent": v["class"] == "unreachable"}, ensure_ascii=False)
    return v["text"].replace("\n", " ")  # polybar (tail), text


# ---------------------------------------------------------------------------
# Commands (clicks)
# ---------------------------------------------------------------------------

STEP = 5  # the widget's wheel: `nudge ±5` per notch (Haus.Licht-plasma main.qml)


def mode_command(st: dict) -> list:
    """Automatic <-> Manual, as the widget's setManual(): following -> hold
    (`dim` the common level when the lit bulbs share one, else `pause`);
    manual -> `resume`."""
    if not st.get("following"):
        return ["resume"]
    levels = [b.get("output") for b in selection_bulbs(st)
              if b.get("power") is not False and b.get("online") is not False]
    nums = [x for x in levels if _num(x) is not None and x > 0]
    if levels and len(nums) == len(levels) and all(abs(x - nums[0]) < 0.05 for x in nums):
        return ["dim", nums[0]]
    return ["pause"]


def run_command(name: str, path: Optional[Path] = None):
    """Send the ctl command(s) of a click; `settings` runs `hauslicht config`."""
    if name == "settings":
        subprocess.Popen(["hauslicht", "config"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return None
    if name == "toggle":
        return request(["toggle"], path=path)
    if name == "up":
        return request(["nudge", STEP], path=path)
    if name == "down":
        return request(["nudge", -STEP], path=path)
    if name == "mode":
        st = request(["get"], path=path)
        return request(mode_command(st or {}), path=path)
    raise ValueError(name)


BUTTONS = {1: "toggle", 2: "mode", 3: "settings", 4: "up", 5: "down"}


def click_from_line(line: str) -> Optional[str]:
    """i3blocks writes a persistent block's clicks to its stdin: a JSON
    object with `button` (format=json) or the button number."""
    line = line.strip()
    if not line:
        return None
    try:
        obj = json.loads(line)
    except ValueError:
        return None
    btn = obj.get("button") if isinstance(obj, dict) else obj
    return BUTTONS.get(btn) if isinstance(btn, int) and not isinstance(btn, bool) else None


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

class Printer:
    """Prints a line whenever it differs from the last one."""

    def __init__(self, fmt: str, template: str, icons: str, out=None):
        self.fmt, self.template, self.icons = fmt, template, icons
        self.out = out or sys.stdout
        self.last: Optional[str] = None
        self.lock = threading.Lock()
        self.broken = threading.Event()

    def __call__(self, st: Optional[dict]):
        line = render(st, self.fmt, self.template, self.icons)
        with self.lock:
            if line == self.last:
                return
            self.last = line
            try:
                self.out.write(line + "\n")
                self.out.flush()
            except (BrokenPipeError, ValueError, OSError):
                self.broken.set()  # the bar went away


def follow(args) -> int:
    printer = Printer(args.format, args.text, args.icons)
    w = Watcher(printer, base_delay=args.base_delay, max_delay=args.max_delay)
    w.start()
    if args.format == "i3blocks":
        def clicks():
            for line in sys.stdin:
                name = click_from_line(line)
                if name:
                    try:
                        run_command(name)
                    except (Unreachable, CtlError, OSError):
                        pass
                    w.refresh()
            # stdin closed: nothing more to read
        threading.Thread(target=clicks, daemon=True).start()
    try:
        printer.broken.wait()
    except KeyboardInterrupt:
        pass
    w.stop()
    return 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="hauslicht-bar",
                                description="Haus.Licht status-bar module (widget 1).")
    p.add_argument("command", nargs="?", choices=["toggle", "mode", "up", "down", "settings"],
                   help="send one command (for clicks) instead of following the state")
    p.add_argument("--format", choices=["waybar", "i3blocks", "polybar", "text"], default="waybar")
    p.add_argument("--text", default=DEFAULT_TEXT,
                   help="template: {icon} {brightness} {state} {name} {mode} {profile}")
    p.add_argument("--icons", choices=sorted(ICONS), default="unicode")
    p.add_argument("--base-delay", type=float, default=1.0, help=argparse.SUPPRESS)
    p.add_argument("--max-delay", type=float, default=30.0, help=argparse.SUPPRESS)
    p.add_argument("--version", action="version", version=__version__)
    args = p.parse_args(argv)
    if args.command:
        try:
            run_command(args.command)
        except (Unreachable, CtlError) as e:
            print(f"hauslicht-bar: {e}", file=sys.stderr)
            return 1
        except FileNotFoundError:
            print("hauslicht-bar: `hauslicht` not found on PATH", file=sys.stderr)
            return 1
        return 0
    return follow(args)


if __name__ == "__main__":
    sys.exit(main())
